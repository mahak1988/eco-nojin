[tool.ruff]
target-version = "py311"
line-length = 100

[tool.ruff.lint]
select = [
    "E",
    "W", 
    "F",
    "I",
    "B",
    "C4",
    "UP",
    "ARG",
    "SIM",
]
ignore = [
    "E501",
    "B008",
    "B904",
]

[tool.ruff.lint.isort]
known-first-party = ["apps"]
known-local-folder = ["apps"]

[tool.ruff.lint.per-file-ignores]
"apps/api/tests/*" = ["ARG", "S101"]
"apps/conftest.py" = ["ARG"]

[tool.ruff.format]
quote-style = "double"
indent-style = "space"
docstring-code-format = true