# =============================================================================
# Econojin root .env template
# LOCATION on your PC:  D:\econojin.com\.env
# Setup:  Copy-Item .env.example .env
# NEVER commit real .env or secrets/*.json
# Keys: leave empty until you register each service
# =============================================================================

# --- Core ---
PROJECT_NAME=Econojin Platform
VERSION=2.0.0
ENVIRONMENT=local
API_V1_STR=/api/v1

# --- Database (Zero-Install default) ---
DATABASE_URL=sqlite+aiosqlite:///./apps/econojin.db
DB_ECHO=false
FORCE_POSTGRES=false
# Optional cloud Postgres later (no Docker):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/econojin
# FORCE_POSTGRES=true

# --- JWT / security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production: ENVIRONMENT=production REJECTS weak placeholders (see apps/shared_core/config.py)
SECRET_KEY=local-dev-only-change-me-use-secrets-token-urlsafe-48
JWT_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REQUIRE_AUTH_FOR_WRITES=false
# Production RS256:
# ALGORITHM=RS256
# JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem

# --- Phase 1 security toggles ---
ENABLE_RATE_LIMIT=true
ENABLE_AUDIT_LOG=true
ENABLE_SPIDERGUARD=false
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
SPIDERGUARD_MAX_REQUESTS=120
SPIDERGUARD_WINDOW_SECONDS=60

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://localhost:3000,http://localhost:8000

# --- Redis / Celery (optional local) ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=

# --- External keys (register yourself; leave empty offline) ---
GEE_SERVICE_ACCOUNT=
GEE_CREDENTIALS_FILE=./secrets/gee-sa.json
GEE_PROJECT_ID=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
OPENWEATHER_API_KEY=
OPEN_METEO_URL=https://api.open-meteo.com/v1
FAO_API_KEY=
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=llama3-8b-8192
OLLAMA_BASE_URL=http://localhost:11434
SENTRY_DSN=

# --- Blockchain / EcoCoin (optional; default = local_ledger, no RPC needed) ---
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology/
BLOCKCHAIN_CHAIN_ID=80002
ECOCONTRACT_ADDRESS=0x0000000000000000000000000000000000000001
ORACLE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000002
# NEVER put a real private key in git or .env.example
BACKEND_WALLET_PRIVATE_KEY=
ECOCOIN_RPC_URL=
ECOCOIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
ECOCOIN_CHAIN_ID=31337
# ECOCOIN_ORACLE_PRIVATE_KEY=   # only via secret store in production

# --- i18n ---
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,fa,ar

ALEMBIC_USE_SQLITE=1
