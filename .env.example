# Econojin .env.example — copy to .env and fill with real values

# === Core ===
SECRET_KEY=<generate-with: python -c "import secrets; print(secrets.token_hex(32))">
DEBUG=false
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://econojin:***@localhost:5432/econojin

# === JWT ===
ALGORITHM=HS256
JWT_SECRET_KEY=<optional-override>

# === Security Service Tokens ===
SERVICE_TOKEN_API=<random-32-char-hex>
SERVICE_TOKEN_CMS=<random-32-char-hex>
SERVICE_TOKEN_AI=<random-32-char-hex>
SERVICE_TOKEN_SIM=<random-32-char-hex>
SERVICE_TOKEN_ML=<random-32-char-hex>

# === Infrastructure ===
REDIS_PASSWORD=<strong-password>
POSTGRES_PASSWORD=<strong-password>

# === CORS ===
BACKEND_CORS_ORIGINS=https://econojin.com,https://www.econojin.com
