# ═══════════════════════════════════════════════════
# econojin.com — Environment Variables Template
# کپی کنید: cp .env.example .env
# سپس مقادیر واقعی را وارد کنید
# ⚠️ هرگز .env را commit نکنید
# ═══════════════════════════════════════════════════

# ── Database ──
DATABASE_URL=***
POSTGRES_PASSWORD=***

# ── Auth & Security ──
SECRET_KEY=***
JWT_SECRET_KEY=***
FIRST_SUPERUSER_PASSWORD=***

# ── AI / LLM ──
LLM_API_KEY=sk-... (OpenAI/Anthropic/...)
QDRANT_API_KEY=***
QDRANT_URL=***
FAO_API_KEY=کلید FAOSTAT API

# ── CMS (Strapi) ──
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=

# ── Smart Contracts ──
CONTRACT_DEPLOYER_KEY=0x... (کلید خصوصی deployer)
RPC_URL=https://rpc.sepolia.org
CONTRACT_ADDRESS=0x... (آدرس EcoCoin)

# ── Frontend ──
VITE_API_URL=http://localhost:8000
VITE_CONTRACT_ADDRESS=0x...

# ── Infrastructure ──
REDIS_URL=redis://localhost:6379/0
FRONTEND_HOST=http://localhost:5173
