# ============================================================
# Econojin - Environment Configuration (.env.example)
# ============================================================
# هشدار: هرگز این فایل را با مقادیر واقعی (مخصوصاً کلیدهای) در Git کامیت نکنید!
# برای استفاده، یک کپی از این فایل با نام `.env` بسازید و مقادیر را پر کنید.
# cp .env.example .env
# ============================================================

# ── 1. Application & Environment ────────────────────────────
PROJECT_NAME=Econojin API
APP_VERSION=2.0.0
ENVIRONMENT=local                  # مقادیر مجاز: local | staging | production
DEBUG=true
LOG_LEVEL=INFO                     # مقادیر مجاز: DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── 2. API & CORS Configuration ─────────────────────────────
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
FRONTEND_HOST=http://localhost:5173
# دامنه‌های مجاز برای CORS (با کاما جدا شوند)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,https://yourdomain.com
ALLOWED_ORIGINS=${BACKEND_CORS_ORIGINS}

# ── 3. Database Configuration ───────────────────────────────
# توسعه (Development): استفاده از SQLite
DATABASE_URL=sqlite+aiosqlite:///./econojin.db

# تولید (Production): استفاده از PostgreSQL (خطوط زیر را از کامنت خارج و تنظیم کنید)
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=changethis
# POSTGRES_DB=econojin
# DATABASE_URL=postgresql+asyncpg://postgres:changethis@localhost:5432/econojin

DB_ECHO=false                      # نمایش کوئری‌های SQL در لاگ (فقط برای دیباگ)

# ── 4. Security & Authentication ────────────────────────────
# یک رشته تصادفی و امن با حداقل ۳۲ کاراکتر تولید کنید (مثلاً با: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # ۲۴ ساعت (برای محیط local می‌تواند بیشتر باشد، مثلاً ۱۱۵۲۰ برای ۸ روز)
REQUIRE_AUTH_FOR_WRITES=false      # در محیط production حتماً روی true تنظیم شود

# تنظیمات اولیه Superuser (فقط برای اولین راه‌اندازی دیتابیس)
FIRST_SUPERUSER=admin@econojin.com
FIRST_SUPERUSER_PASSWORD=changethis

# ── 5. Blockchain & EcoCoin ─────────────────────────────────
# آدرس RPC شبکه (مثال: Polygon Amoy Testnet)
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology/
BLOCKCHAIN_CHAIN_ID=80002

# آدرس قراردادهای هوشمند (پس از Deploy، مقادیر واقعی را جایگزین کنید)
ECOCONTRACT_ADDRESS=0x0000000000000000000000000000000000000001
ORACLE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000002

# کلید خصوصی کیف پول بک‌اند (فقط در صورتی که سرور نیاز به امضای خودکار تراکنش‌ها دارد)
# BACKEND_WALLET_PRIVATE_KEY=

# ── 6. AI & LLM Providers ───────────────────────────────────
# ارائه‌دهنده پیش‌فرض: groq | gemini | openrouter | ollama | fake
LLM_PROVIDER=fake
LLM_MODEL=llama3-8b-8192
LLM_API_KEY=

# Groq (پیشنهادی برای سرعت بالا) - https://console.groq.com
GROQ_API_KEY=

# Google Gemini (کیفیت بالا) - https://aistudio.google.com
GOOGLE_API_KEY=

# OpenRouter (تنوع مدل‌ها) - https://openrouter.ai
OPENROUTER_API_KEY=

# Ollama (اجرای محلی - بدون نیاز به کلید API) - https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434

# ── 7. External Services (SMS, Email, APIs) ─────────────────
# ارائه‌دهنده پیامک: kavenegar | twilio | mock
SMS_PROVIDER=mock
OTP_DEV_MODE=true                  # در توسعه، کد OTP در لاگ چاپ می‌شود

# Kavenegar (ایران)
KAVENEGAR_API_KEY=

# Twilio (بین‌المللی)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# تنظیمات SMTP برای ارسال ایمیل
SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@econojin.com
EMAILS_FROM_NAME=Econojin
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48
EMAIL_TEST_USER=test@example.com

# APIهای خارجی (مثال: Open-Meteo برای داده‌های کشاورزی/آب‌وهوا)
OPEN_METEO_URL=https://api.open-meteo.com/v1

# ── 8. Monitoring & Observability ───────────────────────────
# Sentry.io برای ردیابی خطاها و Performance Tracing
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1             # نرخ نمونه‌برداری برای Tracing (0.0 تا 1.0)
SENTRY_PROFILES_RATE=0.1           # نرخ نمونه‌برداری برای Profiling

# ── 9. Feature Flags ────────────────────────────────────────
# فعال/غیرفعال کردن ماژول‌های خاص بدون تغییر کد
ENABLE_OTP=true
ENABLE_SIMULATION=true
ENABLE_ECOCOIN=true
ENABLE_GIS=true

# ── 10. CMS & Third-party Integrations ──────────────────────
# Strapi CMS
PUBLIC_URL=http://localhost:1337
STRAPI_HOST=0.0.0.0
STRAPI_PORT=1337
ADMIN_JWT_SECRET=change-me-in-production
STRAPI_TOKEN=change-me-in-production

# Supabase (اختیاری - در صورت استفاده از Auth یا DB آن)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# ── 11. Application URL ─────────────────────────────────────
APP_URL=http://localhost:8000