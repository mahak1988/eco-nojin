# =============================================================================
# Econojin — template for local .env
# =============================================================================
# LOCATION (Windows — your machine):
#   D:\econojin.com\.env
#   (same folder as apps\main.py and requirements.txt)
#
# SETUP:
#   copy .env.example .env
#   fill only what you need; leave empty for offline / synthetic mode
#
# NEVER commit .env or secrets/*.json — see .gitignore
# Keys / accounts: register yourself AFTER phase 10 (or when needed).
# =============================================================================

# --- Core ---
PROJECT_NAME=Econojin Platform
VERSION=2.0.0
ENVIRONMENT=local
API_V1_STR=/api/v1

# --- Database (Zero-Install default = SQLite file) ---
# File path relative to process CWD (usually D:\econojin.com):
DATABASE_URL=sqlite+aiosqlite:///./apps/econojin.db
DB_ECHO=false
FORCE_POSTGRES=false
# Optional later (Neon/Supabase or local Postgres — no Docker required if cloud):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/econojin
# FORCE_POSTGRES=true

# --- Security / JWT (apps/shared_core/config.py + security.py) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=local-dev-only-change-me-use-secrets-token-urlsafe-48
JWT_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REQUIRE_AUTH_FOR_WRITES=false
# Production RS256 (phase 10):
# ALGORITHM=RS256
# JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
# Or inline PEM (avoid in repo):
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# --- CORS (comma-separated, no spaces required) ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000

# --- Redis / Celery (optional local; without Redis jobs run sync) ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=

# --- Google Earth Engine (phase 5/10 — after you create SA) ---
# JSON file path (place file yourself; do not commit):
#   D:\econojin.com\secrets\gee-sa.json
GEE_SERVICE_ACCOUNT=
GEE_CREDENTIALS_FILE=./secrets/gee-sa.json
GEE_PROJECT_ID=

# --- Copernicus Data Space (optional) ---
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# --- Sentinel Hub trial (optional — if code reads these names later) ---
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# --- Weather ---
# Open-Meteo needs no key (default):
OPEN_METEO_URL=https://api.open-meteo.com/v1
# Optional paid/official:
OPENWEATHER_API_KEY=
FAO_API_KEY=

# --- LLM / AI agents (default fake = offline) ---
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=llama3-8b-8192
OLLAMA_BASE_URL=http://localhost:11434

# --- Observability ---
SENTRY_DSN=

# --- Blockchain / EcoCoin (testnet defaults; never put mainnet keys in chat) ---
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology/
BLOCKCHAIN_CHAIN_ID=80002
ECOCONTRACT_ADDRESS=0x0000000000000000000000000000000000000001
ORACLE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000002
BACKEND_WALLET_PRIVATE_KEY=

# --- Local helpers (read by scripts/run_local.ps1) ---
ALEMBIC_USE_SQLITE=1
