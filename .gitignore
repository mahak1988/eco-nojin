```gitignore
# Environment variables
.env.local

# Editor/IDE files
.vscode/

# Logs and temporary files
*.log
*.tmp
*.swp

# Dependencies and build artifacts
node_modules/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
dist/
build/
target/
.mypy_cache/
.pytest_cache/
.coverage
coverage/
htmlcov/

# System files
.DS_Store
Thumbs.db

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```