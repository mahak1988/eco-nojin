# Copy to apps/cms/.env — never commit real secrets

HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
NODE_ENV=development

# Generate strong random values for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEYS=key1,key2,key3,key4
ADMIN_JWT_SECRET=change-me-admin-jwt
API_TOKEN_SALT=change-me-api-token-salt
TRANSFER_TOKEN_SALT=change-me-transfer-salt
JWT_SECRET=change-me-users-permissions-jwt

# sqlite (local) | postgres (staging/prod)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# PostgreSQL (production)
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SSL=false

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:1337
