{
  "kind": "collectionType",
  "collectionName": "custom_domains",
  "info": {
    "singularName": "custom-domain",
    "pluralName": "custom-domains",
    "displayName": "Custom Domain",
    "description": "Map custom domains to tenants"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "domain": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "tenantId": {
      "type": "string",
      "required": true
    },
    "sslEnabled": {
      "type": "boolean",
      "default": false
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "createdAt": {
      "type": "datetime"
    },
    "updatedAt": {
      "type": "datetime"
    }
  }
}