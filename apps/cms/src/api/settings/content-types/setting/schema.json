{
  "kind": "singleType",
  "collectionName": "settings",
  "info": {
    "singularName": "setting",
    "pluralName": "settings",
    "displayName": "Setting",
    "description": "Site-level settings"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "tenantId": { "type": "string", "default": "main" },
    "siteName": { "type": "string", "required": true },
    "siteDescription": { "type": "text" },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "defaultSeoTitle": { "type": "string", "maxLength": 60 },
    "defaultSeoDescription": { "type": "text", "maxLength": 160 },
    "analyticsTrackingId": { "type": "string" },
    "customDomain": { "type": "string" }
  }
}
