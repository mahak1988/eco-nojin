{
  "kind": "collectionType",
  "collectionName": "media_items",
  "info": {
    "singularName": "media-item",
    "pluralName": "media-items",
    "displayName": "Media Item",
    "description": "Optional media metadata (Strapi Media Library remains primary)"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "alternativeText": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "required": true
    },
    "mime": {
      "type": "string"
    },
    "size": {
      "type": "decimal"
    },
    "cdnEnabled": {
      "type": "boolean",
      "default": false
    },
    "cdnUrl": {
      "type": "string"
    },
    "tenant": {
      "type": "string",
      "default": "main"
    }
  }
}
