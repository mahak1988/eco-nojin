ENVIRONMENT=staging
PROJECT_NAME=Econojin
SECRET_KEY=docker-staging-change-me-use-openssl-rand-hex-32
ALGORITHM=HS256
# For RS256, mount secrets and set:
# ALGORITHM=RS256
# JWT_PRIVATE_KEY_PATH=/secrets/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=/secrets/jwt_public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REQUIRE_AUTH_FOR_WRITES=true
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
DATABASE_URL=postgresql+asyncpg://econojin:econojin@postgres:5432/econojin
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
GEE_SERVICE_ACCOUNT=
GEE_CREDENTIALS_FILE=/secrets/gee-sa.json
GEE_PROJECT_ID=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
