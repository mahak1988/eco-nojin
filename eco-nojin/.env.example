# Copy to .env — never commit .env

# Local default (Alembic + API without Postgres driver)
DATABASE_URL=sqlite+aiosqlite:///./apps/econojin.db
ENVIRONMENT=local

# Postgres example (requires: pip install "psycopg[binary]")
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/econojin

SECRET_KEY=change-me-to-a-long-random-string-use-secrets-token-urlsafe
JWT_SECRET_KEY=
JWT_ALG=HS256
# F0.4:
# JWT_ALG=RS256
# JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem

REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional integrations — leave empty locally
SENTRY_DSN=
LLM_API_KEY=
